#!/bin/sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
else
    JAVA_CMD=java
fi
exec "$JAVA_CMD" -Xmx512m --enable-preview --add-modules jdk.incubator.vector -cp "$APP_HOME/lib/*" sk.ainet.apps.klfm2.Lfm2IreeChatCli "$@"
